{
  "name": "clinical-rx",
  "productName": "Clinical Rx",
  "version": "1.0.0",
  "description": "CLINICAL Rx — your personal clinical learning companion. Offline-first desktop app (Windows/Ubuntu) that also runs on the web via Vercel.",
  "author": "g2code33",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:web": "tsc --noEmit && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:electron && npm run build:web",
    "start": "electron .",
    "db:generate": "drizzle-kit generate",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke.mjs",
    "vercel-build": "vite build"
  },
  "build": {
    "appId": "com.g2code33.clinicalrx",
    "productName": "Clinical Rx",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "g2code33",
        "repo": "CLINICAL-RX-"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ClinicalRx-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "g2code33",
      "artifactName": "clinical-rx-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dir"
    },
    "npmRebuild": true,
    "extraMetadata": {
      "main": "dist-electron/main.js"
    }
  },
  "dependencies": {
    "@upstash/redis": "^1.38.1",
    "@vercel/node": "^5.9.3",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.24.2",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wait-on": "^7.2.0"
  }
}
